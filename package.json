{
	"name": "obsidian-mobile-export",
	"version": "0.0.6",
	"description": "An Obsidian plugin to export notes on mobile devices",
	"keywords": [],
	"license": "0-BSD",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"@mathjax/mathjax-newcm-font": "^4.1.3",
		"@mathjax/src": "^4.1.3",
		"@takumi-rs/helpers": "^2.14.0",
		"micromark": "^4.0.3",
		"micromark-extension-frontmatter": "^2.0.0",
		"micromark-extension-gfm": "^3.0.0",
		"micromark-extension-math": "^3.1.0",
		"takumi-pdf": "0.15.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"oxfmt": "^0.70.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"packageManager": "pnpm@12.6.0"
}
